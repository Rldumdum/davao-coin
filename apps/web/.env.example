# Copy to .env.local (git-ignored). Local dev needs NONE of this: with NETWORK unset the app
# uses anvil, anvil's public test keys, and an in-memory store.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# ---- browser (VITE_ prefix = bundled into the page = PUBLIC; never put secrets here)
VITE_NETWORK=base-sepolia
# VITE_RPC_URL=https://sepolia.base.org

# ---- server only (api/*, read via process.env, never shipped to the browser)
NETWORK=base-sepolia
# RPC_URL=https://sepolia.base.org          # optional; use a keyed RPC (Alchemy etc.) under load
VOUCHER_SIGNER_KEY=                         # 0x... private key; its address must equal DurianMine.signer()
FAUCET_PRIVATE_KEY=                         # 0x... private key of a wallet holding Base Sepolia ETH
FAUCET_DRIP_WEI=200000000000000             # 0.0002 ETH per new session wallet
SUPABASE_URL=                               # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                  # Supabase → Project Settings → API keys → service_role (secret)
IP_HASH_SALT=                               # any long random string; IPs are stored only as salted hashes

# Optional limits
# LIMIT_SWINGS_PER_IP_PER_MINUTE=40
# LIMIT_SWINGS_PER_ADDRESS_PER_DAY=3000
# LIMIT_DRIPS_PER_IP_PER_DAY=5
# LIMIT_DRIPS_PER_DAY=300
