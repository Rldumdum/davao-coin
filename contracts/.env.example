# Copy to .env (git-ignored) and fill in. TESTNET KEYS ONLY: never put a key that holds real money here.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Pays for the deployment. Fund it from a Base Sepolia faucet.
DEPLOYER_PRIVATE_KEY=
# ADDRESS (not key) of the game server's voucher signer. Its key goes in Vercel as VOUCHER_SIGNER_KEY.
VOUCHER_SIGNER=
# Optional: ETH the money changer starts with, in wei (default 0.01 ETH).
JUN_ETH_WEI=
# For --verify on basescan.org (get one free at etherscan.io; v2 keys work across chains).
BASESCAN_API_KEY=
